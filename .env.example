# Environment Configuration for Agentic Data Analyst

# Server Options
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Options:
# MySQL: mysql+pymysql://username:password@localhost:3306/agentic_analyst
# SQLite (fallback): sqlite:///agentic_analyst.db
DATABASE_URL=sqlite:///agentic_analyst.db

# LLM API Keys (Optional - Intelligent fallback engine active if not provided)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Storage Paths
UPLOAD_DIR=uploads
REPORT_DIR=reports
CHART_DIR=charts
